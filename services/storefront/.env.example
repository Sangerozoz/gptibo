# Non-secret Compose settings. Passwords are separate files in .secrets/.
RELEASE_VERSION=local
PUBLIC_ORIGIN=http://127.0.0.1:8093
# Exact ingress network addresses only; forwarded headers remain untrusted by default.
TRUSTED_PROXY_CIDRS=
# Optional compose.auth.yaml requires independent admin and mail configuration.
# ADMIN_USERNAME=dev-admin
# ADMIN_EMAIL=admin@example.invalid
# MAIL_FROM=硅基生物 <noreply@example.invalid>
